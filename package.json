{
  "name": "verma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm --recursive run check",
    "test": "pnpm --recursive run test",
    "dev": "pnpm --filter @app/api dev",
    "mobile:start": "pnpm --filter @app/mobile start",
    "preview:web": "pnpm --filter @app/mobile-preview dev",
    "test:mobile": "pnpm --filter @app/mobile test",
    "test:preview": "pnpm --filter @app/mobile-preview test"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.8.1"
}
