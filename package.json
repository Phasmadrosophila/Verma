{
  "name": "verma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm --filter @app/shared run build && pnpm --recursive run check",
    "test": "node --test --experimental-strip-types tests/verification/**/*.test.ts && pnpm --recursive run test",
    "test:offline": "node --test --experimental-strip-types tests/verification/offline-ai.test.ts",
    "test:redaction": "node --test --experimental-strip-types tests/verification/redaction-boundary.test.ts",
    "test:sync": "node --test --experimental-strip-types tests/verification/direct-sync.test.ts",
    "test:privacy": "node --test --experimental-strip-types tests/verification/privacy-scanner.test.ts",
    "test:continuity": "pnpm --filter @app/shared test -- --test-name-pattern=Dead",
    "test:rehearsal": "node --test --experimental-strip-types tests/verification/release-rehearsal.test.ts",
    "verify": "node --experimental-strip-types scripts/verify.ts",
    "check:verification": "node --test --experimental-strip-types tests/verification/**/*.test.ts",
    "dev": "pnpm --filter @app/api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:integration": "node --experimental-strip-types scripts/dev-integration.ts",
    "test:integration": "node --test --experimental-strip-types tests/integration/runtime.test.ts",
    "test:e2e:offline": "node --test --experimental-strip-types tests/e2e/offline-visual-e2e.test.ts",
    "mobile:start": "pnpm --filter @app/mobile start",
    "preview:web": "node apps/mobile-preview/server.mjs",
    "test:mobile": "pnpm --filter @app/mobile test",
    "test:preview": "pnpm --filter @app/mobile-preview test",
    "start": "node server.mjs",
    "preview:landing": "node server.mjs",
    "check:landing": "node --check landing.js && node --check server.mjs && node qa/download-page.test.mjs",
    "preview:mobile": "node apps/mobile-preview/server.mjs",
    "check:previews": "node --test qa/preview-*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.8.1"
}
