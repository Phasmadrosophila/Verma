{
  "expo": {
    "name": "Verma",
    "slug": "verma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/verma-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFCF8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phasmadrosophila.verma"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFCF8"
      },
      "package": "com.phasmadrosophila.verma",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/verma-logo.png"
    },
    "extra": {
      "eas": {
        "_comment": "Run `eas init` to populate projectId (do NOT hand-edit it) and set `owner` at the expo root below. Build config is inert until both exist.",
        "projectId": "REPLACE_VIA_EAS_INIT"
      }
    },
    "_owner_note": "After `eas init`, add a top-level \"owner\": \"<expo-account>\" field inside this expo block."
  }
}
