# ==============================================================================
# Verma Deployment Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit real secrets or credentials into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Verma Opaque Envelope Relay Service (P1 Continuity)
# ------------------------------------------------------------------------------
# Random bearer token for authenticating relay store/fetch requests.
RELAY_AUTH_TOKEN=replace-with-a-random-token
RELAY_PORT=8080
RELAY_MAX_ENVELOPE_BYTES=1048576
RELAY_DATA_DIR=/data

# ------------------------------------------------------------------------------
# Verma Vault API Service
# ------------------------------------------------------------------------------
API_PORT=3000
DB_PATH=/data/vault.db

# ------------------------------------------------------------------------------
# Verma Web SPA Service
# ------------------------------------------------------------------------------
WEB_PORT=5173

# ------------------------------------------------------------------------------
# Komodo Orchestration & Management (Self-Hosted Infrastructure)
# ------------------------------------------------------------------------------
KOMODO_BASE_URL=https://komodo-ckn-omv-main.lyra-on.top
KOMODO_API_KEY=replace-with-komodo-api-key
KOMODO_API_SECRET=replace-with-komodo-api-secret
KOMODO_STACK_NAME=verma-stack
